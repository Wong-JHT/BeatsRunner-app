<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- App Identifier -->
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	
	<!-- App Name -->
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	
	<!-- Bluetooth Permissions -->
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>BeatRunner 需要蓝牙权限来连接和控制跑步机设备</string>
	
	<key>NSBluetoothPeripheralUsageDescription</key>
	<string>BeatRunner 需要蓝牙权限来发现附近的跑步机设备</string>
	
	<!-- Media Library / Music Permissions -->
	<key>NSAppleMusicUsageDescription</key>
	<string>BeatRunner 需要访问音乐库来根据音乐节奏智能调整跑步速度</string>
	
	<key>kTCCServiceMediaLibrary</key>
	<string>BeatRunner 需要访问正在播放的音乐信息</string>
	
	<!-- Background Modes -->
	<key>UIBackgroundModes</key>
	<array>
		<string>bluetooth-central</string>
		<string>audio</string>
	</array>
	
	<!-- Supported Interface Orientations (iPhone) -->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	
	<!-- Supported Interface Orientations (iPad) -->
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	
	<!-- Launch Screen -->
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchScreenBackground</string>
	</dict>
</dict>
</plist>
